# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.env
.python-version

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Xcode: User-specific (NEVER commit — machine/developer specific) ─────────
# Each developer has their own xcuserdata with window layouts, breakpoints, etc.
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# ─── Xcode: Build output ──────────────────────────────────────────────────────
DerivedData/
*.build/
*.xcarchive
*.dSYM
*.dSYM.zip

# ─── Xcode: App bundles ───────────────────────────────────────────────────────
# Exception: .app inside the repo source is excluded, but actual build output is not
*.app
*.ipa

# ─── Swift Package Manager ────────────────────────────────────────────────────
# Package.resolved IS intentionally tracked for reproducible builds
# .build/ is excluded above

# ─── Claude Code local config (personal, machine-specific) ───────────────────
.claude/CLAUDE.local.md
.claude/local-notes/

# ─── Local run artifacts ──────────────────────────────────────────────────────
/.dictate_transcripts/
*.log

# ─── Distribution ─────────────────────────────────────────────────────────────
*.pkg
fastlane/report.xml
